# claude-waker config — copy to config.env and edit, then run ./install.sh
# Run install.sh as root on any Debian/Ubuntu host (LXC, VM, or VPS).

# Space-separated account labels. One 5h-window opener per account.
# Each gets its own isolated Claude config dir + its own systemd timer.
ACCOUNTS="a b"

# Offset between consecutive accounts, in minutes.
# 2 accounts @ 150 min => a fresh window every 2h30 (alternating accounts).
# Tip: for N accounts spread evenly, use 300 / N  (e.g. 3 accts => 100).
OFFSET_MINUTES=150

# Window length in minutes. Claude subscription = 5h rolling window. Leave 300.
PERIOD_MINUTES=300

# Timezone for the timers (systemd OnCalendar). Match your billing locale.
TIMEZONE="Europe/Paris"
